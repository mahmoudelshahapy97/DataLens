# Copy to `.env` and edit. Every value has a working local default; the README
# has the full variable table.
#
#   cp .env.example .env
#   make secret          # paste into VANNA_SECRET_KEY
#   make up
#
# Requires the sibling sandbox stack (../../text-to-sql-multi-tenant/databases)
# to be running: it owns the shared Docker network and the seeded datasets.


# ============================================================ MODE ==========
#   demo           anonymous access, per-process limits, no config checks
#   single-tenant  real accounts and limits, one workspace (local default)
#   multi-tenant   every permissive default is refused at boot
# Unrecognised values are treated as multi-tenant (fails closed).
VANNA_DEPLOYMENT_MODE=single-tenant


# ========================================================== SECRETS =========
# Encrypts stored datasource credentials; signs CSRF and OIDC state.
# Back it up with the database -- a restore with a different key leaves every
# stored credential unreadable. No online rotation (see docs/operations.md).
# The value below is public: laptop use only.
VANNA_SECRET_KEY=dev-only-insecure-key-replace-me-before-any-real-deployment

# Platform admins (manage workspaces, datasources, plans, write access).
# Empty means nobody; multi-tenant mode refuses to start with it empty.
VANNA_ADMIN_EMAILS=demo@example.com


# ============================================================== LLM =========
# 'auto' uses whichever key is set, else a mock that streams but writes no SQL.
VANNA_LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=


# ============================================================= DATA =========
# Default warehouse. Swap the database name to switch dataset:
#
#   chinook     11 tables,    15.6k rows   <- default
#   northwind   13 tables,     3.3k rows
#   world        3 tables,     5.3k rows
#   healthcare  10 tables,     7.1k rows
#   ecommerce   16 tables,     8.5k rows
#   booking      9 tables,   119.5k rows
#   pagila      71 tables,   173.3k rows   <- slower first scan
#   employees    6 tables,     3.9M rows   <- slowest first scan
#
# After changing it, run `make clean` so the cached catalog of the previous
# database is dropped. Empty falls back to a built-in SQLite demo.
VANNA_DATABASE_URL=postgresql://postgres:postgres123@db_postgres:5432/chinook


# ==================================================== CONTROL PLANE =========
# Tenants, members, sessions, tokens, plans, audit and generation log. Kept
# separate from the read-only warehouse; created on first start if absent.
# Empty is only allowed in demo mode or with VANNA_ALLOW_ANONYMOUS=true.
VANNA_APP_DATABASE_URL=postgresql://postgres:postgres123@db_postgres:5432/vanna_app

# Workspace used when a request names none.
VANNA_DEFAULT_TENANT=demo

# Run migrations at boot (advisory-locked). With several replicas prefer a
# deploy job: `python -m vanna_app.migrate upgrade`.
VANNA_AUTO_MIGRATE=true


# =================================================== AUTHENTICATION =========
# password, oidc, or both.
VANNA_AUTH_METHODS=password

# First admin's password, used only on an empty users table. Empty generates
# one and prints it once to the API log (`make password`).
VANNA_ADMIN_PASSWORD=

VANNA_SESSION_TTL_HOURS=72

# Secure cookie flag. Must be true behind HTTPS; false only for plain-HTTP
# localhost. Required in multi-tenant mode.
VANNA_SECURE_COOKIES=false

# Proxies whose X-Forwarded-For is trusted. Empty makes every request look like
# it came from nginx, so one shared login throttle locks everyone out.
VANNA_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Accept X-User-Email as identity. Only behind an authenticating gateway that
# strips the header. Refused in multi-tenant mode.
VANNA_TRUST_HEADERS=false

# No authentication at all. Throwaway instances only.
VANNA_ALLOW_ANONYMOUS=false

# Failed sign-ins per address and per IP within the window.
VANNA_LOGIN_MAX_ATTEMPTS=8
VANNA_LOGIN_WINDOW_SECONDS=300

# List workspace members on the sign-in screen. Demo convenience; it exposes
# valid usernames. Refused in multi-tenant mode.
VANNA_PUBLIC_USER_DIRECTORY=true

# Base URL for email links and OIDC redirects.
VANNA_PUBLIC_BASE_URL=http://localhost:3000


# ================================================ SINGLE SIGN-ON ============
# Active only when VANNA_AUTH_METHODS includes oidc. SSO proves identity; access
# still comes from workspace membership.
VANNA_OIDC_ISSUER=
VANNA_OIDC_CLIENT_ID=
VANNA_OIDC_CLIENT_SECRET=
VANNA_OIDC_SCOPES=openid email profile

# Optional: claim -> workspace role, and auto-join new identities to a workspace.
VANNA_OIDC_ROLE_CLAIM=
VANNA_OIDC_AUTO_PROVISION_TENANT=


# ============================================================= MAIL =========
# No host: messages are written to the log instead of sent.
VANNA_SMTP_HOST=
VANNA_SMTP_PORT=587
VANNA_SMTP_USERNAME=
VANNA_SMTP_PASSWORD=
VANNA_SMTP_FROM=vanna@localhost


# ========================================================== LIMITS ==========
# Fallbacks: a workspace override, then its plan, take precedence.
# Quota is questions per workspace per day; rate limit is requests per user per minute.
VANNA_DAILY_QUOTA=200
VANNA_RATE_LIMIT_PER_MIN=20

VANNA_MAX_ROWS=1000
VANNA_QUERY_TIMEOUT=60

# Critic: checks each data answer before it is shown. One extra model call per
# query turn, plus a full turn per rejection.
VANNA_ENABLE_CRITIC=true
VANNA_MAX_CRITIC_RETRIES=1

# Planner: drafts an approach for multi-step questions. One extra call per turn.
VANNA_ENABLE_PLANNER=false

# Connection pools. Must satisfy
#   workers x (APP_POOL_MAX + MAX_TENANT_RUNTIMES x WAREHOUSE_POOL_MAX) <= CONNECTION_BUDGET
# The app logs the sum at boot and warns when it is exceeded.
VANNA_MAX_TENANT_RUNTIMES=2
VANNA_WAREHOUSE_POOL_MAX=2
VANNA_WAREHOUSE_POOL_MIN=0
VANNA_WEB_CONCURRENCY=4
VANNA_CONNECTION_BUDGET=80
VANNA_THREAD_POOL_MAX=32
VANNA_APP_STATEMENT_TIMEOUT_MS=15000
VANNA_TENANT_RUNTIME_TTL_SECONDS=1800

# Days of question history kept. 0 keeps everything.
VANNA_GENERATION_RETENTION_DAYS=365

# Master switch for writes. The workspace also needs allow_writes and the caller
# must be its admin; each write is previewed and needs confirmation.
VANNA_ALLOW_WRITES=false


# ================================================== REPORTS =================
# Scheduled reports run as their named member, so they show only that member's
# data. Allow mailing non-members only if recipients are trusted.
VANNA_REPORT_ALLOW_EXTERNAL_RECIPIENTS=false

# Webhook host allow-list. Empty falls back to blocking private addresses by DNS
# lookup, which is weaker -- set it.
# VANNA_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,outlook.office.com

# Days a run's rendered output is kept. 0 keeps everything.
VANNA_REPORT_RUN_RETENTION_DAYS=90


# ================================================== SEMANTIC LAYER ==========
# VANNA_PROJECT_DIR applies to the default workspace only; VANNA_PROJECTS_DIR
# holds one project per workspace at <root>/<tenant_id>/.
VANNA_PROJECT_DIR=/project
VANNA_PROJECTS_DIR=/projects


# ================================================== CONTENT PATHS ===========
# Auto-detected in both a checkout and the image. Set only when mounting your
# own content elsewhere.
# VANNA_MIGRATIONS_DIR=/app/database/migrations
# VANNA_INSTRUCTIONS_DIR=/app/instructions
# VANNA_DOMAINS_FILE=/app/domains/domains.yml
# VANNA_CONFIG_ROOT=/app


# ================================================== WRITABLE STATE ==========
# Set in docker-compose.yml (/data is a named volume). Shown for reference.
# VANNA_DATA_DIR=/data
# VANNA_SQLITE_PATH=/data/demo.db
# VANNA_KNOWLEDGE_DIR=/data/knowledge
# VANNA_APP_POOL_MAX=16

# Scan each datasource's schema at boot instead of on first use.
VANNA_SCAN_ON_START=true


# ============================================ WHERE CONFIGURATION LIVES =====
# Source of projects, instructions and domains:
#   disk      the YAML tree in this repo
#   database  the `config_files` table (editable from the console); no disk
#             fallback, so a failed import fails loudly
VANNA_CONFIG_SOURCE=disk

# Seconds a worker serves cached config before re-checking the catalog.
VANNA_CONFIG_REFRESH_SECONDS=5

# Import shipped files at boot into an EMPTY catalog only. Turn off once config
# is managed through the API. Manual alternatives:
#   python tools/seed_database.py
#   python tools/import_config_files.py [--dry-run]
VANNA_CONFIG_BOOTSTRAP=false


# ======================================================== RETRIEVAL =========
# `lexical` is dependency-free BM25. `qdrant` fuses in semantic search and needs
# a reachable Qdrant plus OPENAI_API_KEY; without either the API falls back to
# lexical and logs it (/api/vanna/v2/schema shows the active backend).
VANNA_INDEX_BACKEND=lexical

# Schemas longer than this (chars) are sent as search-selected tables instead of
# whole. 0 forces search everywhere (used by backend/evals/sql_accuracy.py).
VANNA_SCHEMA_FULL_TEXT_THRESHOLD=30000
# Tables search keeps, and join-bridge tables added to connect them (0 = off).
VANNA_SCHEMA_SEARCH_LIMIT=15
VANNA_SCHEMA_MAX_BRIDGES=5

# Qdrant runs as its own stack. Use http://127.0.0.1:6333 from the host.
VANNA_QDRANT_URL=http://qdrant:6333

# Required for any Qdrant not bound to loopback (auth is off by default).
VANNA_QDRANT_API_KEY=

# Embeddings via the OpenAI API (needs OPENAI_API_KEY).
VANNA_EMBED_PROVIDER=openai
VANNA_EMBED_MODEL=text-embedding-3-small

# Truncate vectors to save space. Empty = native width (1536 small, 3072 large).
# Models are never interchangeable; the collection refuses a mismatch.
VANNA_EMBED_DIMENSIONS=

# Drop and rebuild the collection when the embedding model changes. Safe (it is
# derived from knowledge/), but a delete, so opt-in.
VANNA_QDRANT_RECREATE_ON_MISMATCH=false


# ============================================================= HTTP =========
# Explicit origins only; '*' is refused.
VANNA_CORS_ORIGINS=http://localhost:3000


# ==================================================== OBSERVABILITY =========
LOG_LEVEL=INFO
# `json` for a log shipper, `text` for humans.
VANNA_LOG_FORMAT=text
# Prometheus /metrics, blocked at nginx -- scrape the API directly.
VANNA_METRICS_ENABLED=true
VANNA_SENTRY_DSN=


# ========================================================== BILLING =========
# Plans live in backend/vanna/core/billing/plans.py; `manual` is the only provider.
VANNA_PAYMENT_PROVIDER=manual
