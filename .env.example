# Copy to `.env` and edit. Every value has a working default, so the stack
# starts with an empty file -- in demo mode, on SQLite, with a mock LLM.
#
#   cp .env.example .env
#   docker compose up --build

# ---------------------------------------------------------------- LLM ------
# 'auto' uses whichever key is set below, falling back to the mock service.
# The mock exercises streaming, components, and the admin flows, but does not
# write real SQL -- set a key for actual answers.
VANNA_LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=

# ---------------------------------------------------------------- Data -----
# PostgreSQL comes from the sibling sandbox project
# (../../text-to-sql-multi-tenant/databases), reached by container name over
# the shared `multidb_network`. Bring that stack up before this one.
#
# Eight datasets are seeded, each in a same-named schema. Swap the database
# name at the end of the URL to switch:
#
#   chinook     11 tables,    15.6k rows   <- default: small and quick to scan
#   northwind   13 tables,     3.3k rows
#   world        3 tables,     5.3k rows
#   healthcare  10 tables,     7.1k rows
#   ecommerce   16 tables,     8.5k rows
#   booking      9 tables,   119.5k rows
#   pagila      71 tables,   173.3k rows   <- slower first scan
#   employees    6 tables,     3.9M rows   <- slowest first scan
#
VANNA_DATABASE_URL=postgresql://postgres:postgres123@db_postgres:5432/chinook

# CHANGING DATABASE: clear the catalog as well, or the previous database's
# tables stay cached and get injected into the prompt -- so the agent is shown
# tables that do not exist on the current connection and writes SQL against
# them. Either:
#     docker compose down -v          # drops the vanna-data volume
# or delete /data/catalog.json inside that volume.
#
# Leaving VANNA_DATABASE_URL empty falls back to a built-in SQLite demo
# database, which is almost never what you want here.

# --------------------------------------------------- Control plane --------
# Where tenants, their members and roles, saved queries, starter questions and
# the generation log are stored. A different database from the one above, on
# purpose: that connection is read-only and points at customer data, and this
# one needs write access for our own bookkeeping. Created on first start if it
# does not exist.
#
# Leave empty to run without a control plane: single-tenant chat still works,
# but workspaces, members, history and saved queries are all disabled.
VANNA_APP_DATABASE_URL=postgresql://postgres:postgres123@db_postgres:5432/vanna_app

# The workspace assumed when a request names none, and the one created on an
# empty directory.
VANNA_DEFAULT_TENANT=demo

# Each workspace can be bound to its own data source from the admin console, so
# one deployment can serve `chinook` to one tenant and `ecommerce` to another.
# VANNA_DATABASE_URL above is the fallback for workspaces with no binding.

# Lets the sign-in screen list a workspace's members so they can be picked
# rather than typed. Convenient for a demo; anywhere else it publishes who
# belongs to a workspace to anyone who can reach the page.
VANNA_PUBLIC_USER_DIRECTORY=true

# ------------------------------------------------- Semantic layer ---------
# A project directory holding models, relationships, metrics and access rules.
# When set, the agent writes SQL against *model* names -- `orders`, `revenue`,
# `customer.region` -- and every tool call is compiled to real SQL and
# access-checked inside the tool registry.
#
#   vanna project init analytics --dialect postgres
#   vanna project from-catalog          # draft models from a scan
#   vanna project validate && vanna project build
#
# The container reads target/mdl.json, not the YAML, so what runs is what
# someone deliberately built. Leave empty to use the scanned catalog directly,
# which is the behaviour this stack had before the semantic layer existed.
VANNA_PROJECT_DIR=

# A directory of projects, one per workspace, at <root>/<tenant_id>/. A manifest
# describes one database, so this is how a multi-workspace deployment binds each
# to its own -- VANNA_PROJECT_DIR above applies to the default workspace only.
# A workspace with no project here simply uses its scanned catalog.
VANNA_PROJECTS_DIR=

# Retrieval ranking. `lexical` is dependency-free BM25 over an inverted index,
# and matches on the column *values* the scanner profiled -- so "cancelled
# orders" finds the orders table through its status enum, which keyword overlap
# cannot do. Naming a vector integration (chromadb, qdrant, faiss) fuses it with
# lexical using reciprocal rank fusion.
#
# A backend that cannot be built logs a warning and falls back to lexical; the
# backend actually in use is reported on /api/vanna/v2/schema, because a silent
# downgrade looks exactly like answers quietly getting worse after a deploy.
# Retrieval ranking.
#
#   lexical  BM25 keyword matching. No dependencies, no server, nothing to run.
#   qdrant   BM25 *fused with* semantic search over local embeddings. Finds
#            "revenue by region" when someone asks "sales per area" -- which
#            shares no words with it and which BM25 alone cannot match.
#
# `qdrant` needs the qdrant service from docker-compose.yml. If it is
# unreachable the API still starts and falls back to lexical, saying so in the
# log and on /api/vanna/v2/schema -- a silent downgrade would look exactly like
# answers getting worse after a deploy.
VANNA_INDEX_BACKEND=lexical

# Where the vector store lives. Ignored unless the backend above is `qdrant`.
VANNA_QDRANT_URL=http://qdrant:6333

# Embedding model, run locally through fastembed -- no API key, no network, no
# per-token cost. ~130 MB, downloaded once into the embed-cache volume.
# Changing it changes the vector width, so the collection must be recreated:
#   docker compose exec qdrant sh -c 'rm -rf /qdrant/storage/collections/vanna_knowledge'
VANNA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- Limits ---
# Rows returned per query. The runner fetches one extra to detect truncation
# and tells the model when a result is partial.
VANNA_MAX_ROWS=1000

# Wall-clock seconds per query, applied client-side and server-side.
VANNA_QUERY_TIMEOUT=60

# Per-user caps. Quota bounds cost over a day; the rate limit bounds load over
# a minute. Both are per-process -- see the docstring in core/lifecycle/quota.py
# before relying on the exact numbers with more than one worker.
VANNA_DAILY_QUOTA=200
VANNA_RATE_LIMIT_PER_MIN=20

# ---------------------------------------------------------------- Access ---
# Comma-separated *platform* admin addresses: they can create and delete
# workspaces and manage the members of any of them. Workspace-level admins are
# rows in the directory instead, granted from the console.
#
# These addresses also seed the first workspace's admin list on an empty
# directory, so set them before the first start if you can.
#
# LEAVING THIS EMPTY MAKES EVERY USER A PLATFORM ADMIN -- and therefore able to
# read every workspace, which is multi-tenancy in name only. The compose file
# defaults it to the seeded demo account for that reason. Set it to your own
# addresses.
VANNA_ADMIN_EMAILS=demo@example.com

# ------------------------------------------------- Authentication ---------
# People sign in with a password and get an httpOnly session cookie. The first
# platform admin above is seeded on an empty install; leave the password unset
# and one is generated and printed to the log ONCE at first start.
VANNA_ADMIN_PASSWORD=

# Accept X-User-Email as proof of identity. Off by default, and only consulted
# while no account exists (so a fresh install is reachable). Turn it on only
# when this sits behind a gateway that authenticates and sets the header itself
# -- you are then trusting that gateway, not this process.
VANNA_TRUST_HEADERS=false

# Send the session cookie only over HTTPS. MUST be true in any real deployment.
# False here because the compose stack serves plain HTTP on localhost, where a
# Secure cookie is simply never sent and login appears broken.
VANNA_SECURE_COOKIES=false

VANNA_SESSION_TTL_HOURS=72
VANNA_LOGIN_MAX_ATTEMPTS=8
VANNA_LOGIN_WINDOW_SECONDS=300

# Scan the database schema on startup. Turn off for a very large warehouse and
# run the scan out of band instead.
VANNA_SCAN_ON_START=true

# Only needed when the UI is served from a different origin than the API. The
# compose stack proxies /api through nginx, so they share an origin and this is
# unused.
VANNA_CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
