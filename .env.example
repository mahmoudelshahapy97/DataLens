# Copy to `.env` and edit.
#
#   cp .env.example .env
#   make secret          # paste the result into VANNA_SECRET_KEY below
#   make up
#
# Every value has a working default for a local sandbox. The README has the full
# variable table; this file carries the ones you are likely to change and the
# reasoning behind the defaults that are not obvious.
#
# PREREQUISITE: the sibling sandbox stack must be running first
# (../../text-to-sql-multi-tenant/databases). It owns the Docker network this stack
# joins and the eight seeded datasets.


# ============================================================ MODE ==========
#
#   demo           Anonymous access, per-process limits, no configuration checks.
#                  What `docker compose up` with an empty file gets. Never a real
#                  deployment.
#   single-tenant  Real accounts, real limits, one workspace expected. The honest
#                  description of a local sandbox, and the default below.
#   multi-tenant   The product. Every permissive default is REFUSED at boot, and
#                  the API prints every problem at once rather than starting.
#
# An unrecognised value is treated as multi-tenant, so a typo fails closed.
VANNA_DEPLOYMENT_MODE=single-tenant


# ========================================================== SECRETS =========
#
# Encrypts stored datasource credentials and signs CSRF and OIDC state.
#
#   make secret
#
# BACK THIS UP WITH THE DATABASE. Datasource credentials are sealed with a key
# derived from it; a restore with a different key leaves every workspace bound to a
# connection nobody can open. There is no online rotation -- see docs/operations.md.
#
# The value below is a KNOWN string and is acceptable only on a laptop.
VANNA_SECRET_KEY=dev-only-insecure-key-replace-me-before-any-real-deployment

# Platform admins: create and delete workspaces, bind datasources, grant write
# access, set plans, administer any workspace.
#
# An empty list means NOBODY is a platform admin. It used to mean everybody, which
# made the multi-tenancy in this stack indistinguishable from having none -- every
# authenticated user could read every workspace. multi-tenant mode refuses to start
# with this empty.
VANNA_ADMIN_EMAILS=demo@example.com


# ============================================================== LLM =========
#
# 'auto' uses whichever key is set below, falling back to the mock service. The mock
# exercises streaming, components and the admin flows, but does not write real SQL.
VANNA_LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=


# ============================================================= DATA =========
#
# The warehouse workspaces query by default. Reached by container name over the
# shared sandbox network.
#
# Eight datasets are seeded, each in a same-named database. Swap the name at the end
# to switch:
#
#   chinook     11 tables,    15.6k rows   <- default: small and quick to scan
#   northwind   13 tables,     3.3k rows
#   world        3 tables,     5.3k rows
#   healthcare  10 tables,     7.1k rows
#   ecommerce   16 tables,     8.5k rows
#   booking      9 tables,   119.5k rows
#   pagila      71 tables,   173.3k rows   <- slower first scan
#   employees    6 tables,     3.9M rows   <- slowest first scan
#
# Leaving this EMPTY falls back to a built-in SQLite demo, which is almost never
# what you want here.
#
# CHANGING IT: clear the catalog as well, or the previous database's tables stay
# cached and are injected into the prompt -- so the agent is shown tables that do not
# exist on the current connection and writes SQL against them.
#
#   make clean        # drops the volumes
#
# Repointing a workspace from the console does this automatically; only a change to
# this variable needs the manual step.
VANNA_DATABASE_URL=postgresql://postgres:postgres123@db_postgres:5432/chinook


# ==================================================== CONTROL PLANE =========
#
# Tenants, members, roles, sessions, API tokens, plans, payments, the generation log,
# the audit trail and the shared counters. A different database from the one above,
# on purpose: that connection is read-only and belongs to the customer, and our
# bookkeeping has no business in it. Created on first start if absent.
#
# Leaving this empty is only permitted in demo mode, or with VANNA_ALLOW_ANONYMOUS
# set explicitly. It used to be permitted everywhere, and an unreachable control
# plane silently turned the API into an unauthenticated one.
VANNA_APP_DATABASE_URL=postgresql://postgres:postgres123@db_postgres:5432/vanna_app

# The workspace assumed when a request names none, and the one created on an empty
# directory.
VANNA_DEFAULT_TENANT=demo

# Migrations at boot. Safe with several replicas (they take an advisory lock), but
# prefer a deploy job once there is more than one: set this false and run
# `python -m vanna_app.migrate upgrade` before the rollout.
VANNA_AUTO_MIGRATE=true


# =================================================== AUTHENTICATION =========

# password, oidc, or both.
VANNA_AUTH_METHODS=password

# First-run administrator password. Leave empty and one is generated and printed
# ONCE in the API log -- `make password` finds it. Only the hash is stored.
VANNA_ADMIN_PASSWORD=

VANNA_SESSION_TTL_HOURS=72

# Send the session cookie only over HTTPS. Must be true in any real deployment, and
# multi-tenant mode refuses to start without it. False here because the compose
# stack serves plain HTTP on localhost, where a Secure cookie is simply never sent
# and login looks broken.
VANNA_SECURE_COOKIES=false

# Which hops in X-Forwarded-For may be believed. nginx sits on the compose bridge
# network, so its address is in 172.16/12.
#
# WITH THIS EMPTY the header is ignored entirely and every request appears to come
# from the proxy -- so the per-IP login throttle spends one shared budget and locks
# out all users at once. multi-tenant mode refuses to start without it.
VANNA_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Accept X-User-Email as proof of identity. Only behind a gateway that authenticates
# and strips the header -- in which case the gateway, not this process, is the thing
# being trusted. Refused in multi-tenant mode.
VANNA_TRUST_HEADERS=false

# No authentication at all. For a throwaway instance on a trusted network.
VANNA_ALLOW_ANONYMOUS=false

# Failed sign-ins per address AND per client IP, within the window. Counted in the
# control plane, so the limit is the limit however many workers are running.
VANNA_LOGIN_MAX_ATTEMPTS=8
VANNA_LOGIN_WINDOW_SECONDS=300

# Lets the sign-in screen list a workspace's members so they can be picked rather
# than typed. Convenient for a demo; anywhere else it publishes who belongs to a
# workspace to anyone who can reach the page. Refused in multi-tenant mode.
VANNA_PUBLIC_USER_DIRECTORY=true

# Where links in emails point, and the OIDC redirect base.
VANNA_PUBLIC_BASE_URL=http://localhost:3000


# ================================================ SINGLE SIGN-ON ============
#
# Off unless VANNA_AUTH_METHODS names oidc. Discovery is read from
# <issuer>/.well-known/openid-configuration.
#
# The identity provider says who somebody is. It does not grant access: membership
# still comes from the workspace directory, so an SSO identity with no membership can
# sign in and reach nothing.
VANNA_OIDC_ISSUER=
VANNA_OIDC_CLIENT_ID=
VANNA_OIDC_CLIENT_SECRET=
VANNA_OIDC_SCOPES=openid email profile

# Map a claim onto a workspace role, and auto-join new identities to a workspace.
# Both off by default: joining a workspace is a decision, and a claim in a token
# somebody else issues should not be able to make it silently.
VANNA_OIDC_ROLE_CLAIM=
VANNA_OIDC_AUTO_PROVISION_TENANT=


# ============================================================= MAIL =========
#
# With no host, messages are written to the log instead of sent -- so the
# forgot-password and invitation flows are exercisable without a mail server.
VANNA_SMTP_HOST=
VANNA_SMTP_PORT=587
VANNA_SMTP_USERNAME=
VANNA_SMTP_PASSWORD=
VANNA_SMTP_FROM=vanna@localhost


# ========================================================== LIMITS ==========

# Questions per WORKSPACE per rolling day. Overridden by the plan, and by an
# explicit per-workspace override.
VANNA_DAILY_QUOTA=200

# Requests per user per minute. Bounds load, where the quota bounds cost.
VANNA_RATE_LIMIT_PER_MIN=20

VANNA_MAX_ROWS=1000
VANNA_QUERY_TIMEOUT=60

# Check each data answer against the question before the user sees it. Costs
# one extra model call per turn that ran a query, and a further full turn each
# time it rejects -- all of it metered and billed like any other call. Set to
# false, or set retries to 0, to switch it off.
VANNA_ENABLE_CRITIC=true
VANNA_MAX_CRITIC_RETRIES=1

# Draft an approach before answering a multi-step question. Off by default: it
# costs a call on every turn it fires and there is no cheap way to tell in
# advance whether the question needed it.
VANNA_ENABLE_PLANNER=false

# Cached per-workspace agents. Each holds a warehouse connection pool, so
# max_runtimes x pool size x replicas must fit inside what the warehouse permits.
# Every pool is per worker process and this image runs four, so the ceiling is
#     workers x (APP_POOL_MAX + MAX_TENANT_RUNTIMES x WAREHOUSE_POOL_MAX)
# which must stay inside VANNA_CONNECTION_BUDGET. The app logs the sum at boot and
# warns if it does not. Note that a control plane sharing a server with the
# warehouses shares this budget.
VANNA_MAX_TENANT_RUNTIMES=2
VANNA_WAREHOUSE_POOL_MAX=2
VANNA_WAREHOUSE_POOL_MIN=0
VANNA_WEB_CONCURRENCY=4
VANNA_CONNECTION_BUDGET=80
VANNA_THREAD_POOL_MAX=32
VANNA_APP_STATEMENT_TIMEOUT_MS=15000
VANNA_TENANT_RUNTIME_TTL_SECONDS=1800

# Question text is customer data and this table never stopped growing. 0 keeps
# everything forever, which is a decision rather than a default.
VANNA_GENERATION_RETENTION_DAYS=365

# Master switch for write statements. A workspace ALSO needs allow_writes (settable
# only by a platform admin), AND the caller must be an admin of it. A write is then
# previewed with an estimated row count and needs a confirmed second call.
VANNA_ALLOW_WRITES=false


# ================================================== REPORTS =================
#
# A report is a dashboard that declares parameters, on a schedule. Its tiles
# execute as a *named member* -- report_schedules.run_as -- through exactly the
# path a browser request uses, so the figures in a delivered report are the ones
# that person is permitted to see and no more.

# Whether a scheduled report may be mailed to an address that is not a member of
# the workspace.
#
# Off, and the default is the whole point. A report carries one member's view of
# the data; a schedule that can mail anybody is a way to hand that view to
# anybody, without anything in the system objecting. Turn this on only when the
# deployment has decided its recipients are trusted.
VANNA_REPORT_ALLOW_EXTERNAL_RECIPIENTS=false

# Hosts a report webhook may post to, comma-separated. Empty means no allow-list,
# and the outbound guard then falls back to resolving the name and refusing
# private and link-local addresses -- weaker, because DNS can answer differently
# when the request is actually made.
#
# Worth setting. The request is made *by the API container*, from inside the
# network, so an unrestricted webhook URL is a way to make this deployment fetch
# http://169.254.169.254/ with its own credentials by editing a text field.
# VANNA_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,outlook.office.com

# How long a run's rendered artifact is kept. The bytes are the bulk of the row;
# that a run happened outlives them in `generations` and `admin_audit`, which is
# what an investigation reads. 0 keeps them forever.
VANNA_REPORT_RUN_RETENTION_DAYS=90


# ================================================== SEMANTIC LAYER ==========
#
# A manifest describes ONE database, so it binds to the workspace whose database it
# describes:
#
#   VANNA_PROJECT_DIR   applies to the default workspace only.
#   VANNA_PROJECTS_DIR  a directory of projects, one per workspace, at
#                       <root>/<tenant_id>/. Use this once there is more than one.
VANNA_PROJECT_DIR=/project
VANNA_PROJECTS_DIR=/projects


# ================================================== CONTENT PATHS ===========
#
# Where the backend looks for the content it ships: the schema migrations, the
# instruction baseline and packs, the workspace definitions, and the tree the
# boot-time configuration import reads.
#
# All four resolve themselves by walking up from the module that needs them, which
# lands on the right directory in a checkout and in the image alike -- the Dockerfile
# copies each to the same relative position it has here. You only need these when a
# deployment mounts its own content somewhere else, and they are the escape hatch if
# a refactor ever moves one of these directories.
#
#   VANNA_MIGRATIONS_DIR    default <repo>/database/migrations  (image: /app/database/migrations)
#   VANNA_INSTRUCTIONS_DIR  default <repo>/backend/instructions (image: /app/instructions)
#   VANNA_DOMAINS_FILE      default <repo>/backend/domains/domains.yml
#   VANNA_CONFIG_ROOT       default the first ancestor holding projects/ or instructions/
#
# VANNA_MIGRATIONS_DIR=/app/database/migrations
# VANNA_INSTRUCTIONS_DIR=/app/instructions
# VANNA_DOMAINS_FILE=/app/domains/domains.yml
# VANNA_CONFIG_ROOT=/app


# ================================================== WRITABLE STATE ==========
#
# Set in docker-compose.yml, where /data is a named volume that survives a rebuild.
# Listed here because they exist and were previously documented nowhere.
#
#   VANNA_DATA_DIR       root for the writable state below. Image default /data.
#   VANNA_SQLITE_PATH    the built-in SQLite demo database.
#   VANNA_KNOWLEDGE_DIR  the markdown knowledge directory.
#   VANNA_SCAN_ON_START  scan each datasource's schema at boot rather than on first use.
#   VANNA_APP_POOL_MAX   control-plane connection pool ceiling, per worker.
#
# VANNA_DATA_DIR=/data
# VANNA_SQLITE_PATH=/data/demo.db
# VANNA_KNOWLEDGE_DIR=/data/knowledge
# VANNA_SCAN_ON_START=false
# VANNA_APP_POOL_MAX=16


# ============================================ WHERE CONFIGURATION LIVES =====
#
# Semantic projects, the instruction library and the domain definitions are all
# files in this repository. They can also live in the control plane, in
# `config_files` -- which is what lets an administrator change a cube from the
# console instead of rebuilding an image.
#
#   disk      read the YAML tree. What every deployment did before the catalog.
#   database  read `config_files`. Nothing is read from disk, ever.
#
# Two modes rather than "try the database, fall back to disk". A silent fallback
# turns a failed import into a deployment that looks healthy while serving the
# configuration its image happened to ship with, and the point of moving this into
# PostgreSQL is that what is running is knowable. Switching back is one variable.
VANNA_CONFIG_SOURCE=disk

# How long a worker may serve cached configuration before re-checking the
# catalog's fingerprint. Each worker has its own cache and there are four of them,
# so this -- not the write -- is what bounds how long an edit takes to appear.
VANNA_CONFIG_REFRESH_SECONDS=5

# Import the shipped files at boot, but only into an EMPTY catalog. For a fresh
# volume and for local work. Turn it off once configuration is managed through the
# API, so a restart cannot reinstate what the image was built with.
VANNA_CONFIG_BOOTSTRAP=false

# Populate it by hand instead:
#   python tools/seed_database.py            migrate + import + regenerate database/
#   python tools/import_config_files.py      import only, checksum-gated
#   python tools/import_config_files.py --dry-run

# Retrieval ranking. `lexical` is dependency-free BM25 and needs nothing else;
# `qdrant` fuses semantic search into it by reciprocal rank fusion and needs two
# things -- a reachable Qdrant AND an OpenAI key for the embedder below, since
# embeddings are hosted and there is no local model to fall back to. Missing
# either costs ranking quality, not answers: the API starts and logs a downgrade,
# and /api/vanna/v2/schema reports the backend actually in use.
VANNA_INDEX_BACKEND=lexical

# Schemas whose rendered text is longer than this (characters) are sent as the
# tables search selects for each question rather than whole. 0 forces search on
# every schema, which is how backend/evals/sql_accuracy.py simulates a large
# warehouse against the small demo databases.
VANNA_SCHEMA_FULL_TEXT_THRESHOLD=30000

# Qdrant runs as its own stack, not as a service in this one, so the collection
# survives a `docker compose down -v` here and can be shared. Containers on the
# shared network reach it by service name; use 127.0.0.1:6333 from the host.
VANNA_QDRANT_URL=http://qdrant:6333

# Qdrant ships with authentication OFF. Leave empty only for an instance bound to
# loopback; anything reachable further away -- a managed cluster, or a published
# port -- is an open read/write vector store until this is set.
VANNA_QDRANT_API_KEY=

# Where vectors come from, when a vector backend is enabled above.
#
# text-embedding-3-* over the OpenAI API: nothing in memory, nothing to download,
# and a network round trip plus a per-token charge on every index pass and every
# query. OPENAI_API_KEY is therefore required alongside a vector backend -- with
# no key the API still starts and retrieval falls back to keyword-only BM25.
#
# `-3-small` over `-3-large`: five times cheaper, and the gap between them is
# smaller than the gap between either and keyword search.
VANNA_EMBED_PROVIDER=openai
VANNA_EMBED_MODEL=text-embedding-3-small

# Shorten the vector. These models are trained so a truncated vector is still
# usable, so this trades a little accuracy for a smaller index. Empty means
# native width (1536 for -3-small, 3072 for -3-large).
#
# It does NOT make two models interchangeable. Same width is not the same vector
# space: a truncated -3-large vector compared against a -3-small one returns
# plausible nonsense rather than an error, so the collection records which model
# wrote it and refuses a mismatch.
VANNA_EMBED_DIMENSIONS=

# Changing embedding model makes an existing collection unusable. It is derived
# from the markdown under knowledge/, so rebuilding loses nothing -- but it is
# still a delete, so it is opt-in.
VANNA_QDRANT_RECREATE_ON_MISMATCH=false


# ============================================================= HTTP =========
#
# Explicit origins; '*' is rejected by browsers alongside credentials, and refused
# by the configuration check.
VANNA_CORS_ORIGINS=http://localhost:3000


# ==================================================== OBSERVABILITY =========

LOG_LEVEL=INFO

# `json` for a log shipper, `text` for a human reading `make logs`. Every line
# carries request_id, tenant_id and user_id either way.
VANNA_LOG_FORMAT=text

# Prometheus at /metrics, blocked at the nginx edge -- scrape the API directly.
VANNA_METRICS_ENABLED=true

VANNA_SENTRY_DSN=


# ========================================================== BILLING =========
#
# Plans are code constants (backend/vanna/core/billing/plans.py); only the provider is
# configurable, and `manual` is the only implementation.
VANNA_PAYMENT_PROVIDER=manual
