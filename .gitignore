# ============================================
# Databases / Local Data
# ============================================

*.db
*.sqlite
*.sqlite3

# Local database data. Anchored to the repository root on purpose: unanchored,
# `data/` matched backend/vanna/components/rich/data/ and kept three Python
# source files out of git entirely, and `database/` matched the SQL schema
# directory, so migrations 0010 to 0012 and its README were never committed.
# The earlier migrations survived only because they predated the rule.
/data/
/db_data/

# ============================================
# Uploads / Generated Files
# ============================================

# Anchored, all of them. Unanchored `data/` once hid
# `backend/vanna/components/rich/data/`, and unanchored `models/` hid 23
# `backend/projects/*/models/metadata.yml` -- see the notes on those rules. `media/`
# was the same bug waiting to happen: it matched the real source directory
# `frontend/public/media/`, so anything added there was silently ignored. These are
# root-level scratch and upload directories; a leading slash is what says so.
/uploads/
/media/
/staticfiles/
/tmp/
/temp/

# ============================================
# ML / AI
# ============================================

*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.bin

# Also anchored: these name machine-learning outputs, but `models/` unanchored
# matched backend/projects/*/models/, which is the authored semantic layer --
# 23 metadata.yml files describing the warehouse, not a training checkpoint.
/models/
/checkpoints/
/runs/
/wandb/

