          "isHidden": false
        }
      ],
      "rowLevelAccessControls": []
    },
    {
      "name": "playlist_tracks",
      "description": "The many-to-many bridge between playlists and tracks. It carries no facts of its own; counting rows here counts placements, not distinct tracks.",
      "tableReference": "chinook.playlist_track",
      "columns": [
        {
          "name": "playlist_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "track_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        }
      ],
      "rowLevelAccessControls": []
    },
    {
      "name": "playlists",
      "description": "A named playlist. Its tracks are reached through playlist_tracks.",
      "tableReference": "chinook.playlist",
      "columns": [
        {
          "name": "playlist_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": true,
          "isHidden": false
        },
        {
          "name": "name",
          "type": "VARCHAR",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        }
      ],
      "rowLevelAccessControls": []
    },
    {
      "name": "tracks",
      "description": "One row per track in the catalogue. Length and file size are stored in milliseconds and bytes; the calculated columns below are what people mean.",
      "tableReference": "chinook.track",
      "columns": [
        {
          "name": "track_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": true,
          "isHidden": false
        },
        {
          "name": "name",
          "type": "VARCHAR",
          "description": "Track title.",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "composer",
          "type": "VARCHAR",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "album_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "genre_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "media_type_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "unit_price",
          "type": "NUMERIC",
          "description": "List price in dollars.",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "milliseconds",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "minutes",
          "type": "DOUBLE",
          "description": "Track length in minutes. Nobody asks for milliseconds.",
          "expression": "milliseconds / 60000.0",
          "isCalculated": true,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "bytes",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "megabytes",
          "type": "DOUBLE",
          "description": "File size in MB.",
          "expression": "bytes / 1048576.0",
          "isCalculated": true,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        }
      ],
      "rowLevelAccessControls": []
    }
  ],
  "relationships": [
    {
      "name": "artist_albums",
      "models": [
        "artists",
        "albums"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "artists.artist_id = albums.artist_id",
      "description": "An artist has many albums."
    },
    {
      "name": "album_tracks",
      "models": [
        "albums",
        "tracks"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "albums.album_id = tracks.album_id",
      "description": "The only path from a track to its artist."
    },
    {
      "name": "genre_tracks",
      "models": [
        "genres",
        "tracks"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "genres.genre_id = tracks.genre_id"
    },
    {
      "name": "media_type_tracks",
      "models": [
        "media_types",
        "tracks"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "media_types.media_type_id = tracks.media_type_id"
    },
    {
      "name": "track_sales",
      "models": [
        "tracks",
        "invoice_lines"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "tracks.track_id = invoice_lines.track_id",
      "description": "Every sale of a track. Summing track.unit_price here would be wrong."
    },
    {
      "name": "invoice_items",
      "models": [
        "invoices",
        "invoice_lines"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "invoices.invoice_id = invoice_lines.invoice_id",
      "description": "An invoice has many lines, so invoices.total fans out across them. Use invoice_lines.line_revenue below invoice level and invoices.total at it."
    },
    {
      "name": "customer_invoices",
      "models": [
        "customers",
        "invoices"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "customers.customer_id = invoices.customer_id"
    },
    {
      "name": "support_rep_customers",
      "models": [
        "employees",
        "customers"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "employees.employee_id = customers.support_rep_id",
      "description": "The sales rep relationship. \"Which rep sells the most\" reaches revenue through this edge and then customers -> invoices."
    },
    {
      "name": "playlist_entries",
      "models": [
        "playlists",
        "playlist_tracks"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "playlists.playlist_id = playlist_tracks.playlist_id"
    },
    {
      "name": "track_placements",
      "models": [
        "tracks",
        "playlist_tracks"
      ],
      "joinType": "ONE_TO_MANY",
      "condition": "tracks.track_id = playlist_tracks.track_id"
    }
  ],
  "views": [],
  "cubes": [
    {
      "name": "sales",
      "baseObject": "invoices",
      "description": "Revenue as invoiced to customers.",
      "measures": [
        {
          "name": "revenue",
          "expression": "SUM(total)",
          "type": "DOUBLE",
          "description": "Total invoiced, in dollars."
        },
        {
          "name": "invoice_count",
          "expression": "COUNT(*)",
          "type": "BIGINT"
        },
        {
          "name": "average_invoice",
          "expression": "AVG(total)",
          "type": "DOUBLE"
        }
      ],
      "dimensions": [
        {
          "name": "country",
          "expression": "billing_country",
          "type": "VARCHAR"
        },
        {
          "name": "city",
          "expression": "billing_city",
          "type": "VARCHAR"
        }
      ],
      "timeDimensions": [
        {
          "name": "invoiced_on",
          "expression": "invoice_date",
          "type": "TIMESTAMP"
        }
      ]
    },
    {
      "name": "track_sales",
      "baseObject": "invoice_lines",
      "description": "Revenue attributed to individual tracks, and through them to artists.",
      "measures": [
        {
          "name": "revenue",
          "expression": "SUM(unit_price * quantity)",
          "type": "DOUBLE",
          "description": "Line revenue in dollars. The definition of revenue below invoice level."
        },
        {
          "name": "units_sold",
          "expression": "SUM(quantity)",
          "type": "BIGINT"
        },
        {
          "name": "line_count",
          "expression": "COUNT(*)",
          "type": "BIGINT",
          "description": "Number of sale lines, which is not the same as units sold."
        }
      ],
      "dimensions": [],
      "timeDimensions": []
    }
  ]
}
