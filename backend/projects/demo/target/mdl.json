          "isHidden": false
        }
      ],
      "rowLevelAccessControls": []
    },
    {
      "name": "invoice_lines",
      "description": "A single track on an invoice. This is where revenue is attributed to a track, and therefore the only place an artist's earnings can be computed from.",
      "tableReference": "chinook.invoice_line",
      "columns": [
        {
          "name": "invoice_line_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": true,
          "isHidden": false
        },
        {
          "name": "invoice_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "track_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "unit_price",
          "type": "NUMERIC",
          "description": "Price charged for this line, in dollars.",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "quantity",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "line_revenue",
          "type": "NUMERIC",
          "description": "Revenue for this line. Summing this is what \"revenue\" means for anything below invoice level -- an artist, an album, a track or a genre.",
          "expression": "unit_price * quantity",
          "isCalculated": true,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        }
      ],
      "rowLevelAccessControls": []
    },
    {
      "name": "invoices",
      "description": "One row per customer invoice. `total` is the invoice-level amount; per-track revenue lives in invoice_lines and is not the same number.",
      "tableReference": "chinook.invoice",
      "columns": [
        {
          "name": "invoice_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": true,
          "isHidden": false
        },
        {
          "name": "customer_id",
          "type": "INTEGER",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": true
        },
        {
          "name": "invoice_date",
          "type": "TIMESTAMP",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "billing_city",
          "type": "VARCHAR",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "billing_state",
          "type": "VARCHAR",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "billing_country",
          "type": "VARCHAR",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        },
        {
          "name": "total",
          "type": "NUMERIC",
          "description": "Invoice total in dollars.",
          "isCalculated": false,
          "notNull": false,
          "isPrimaryKey": false,
          "isHidden": false
        }
      ],
      "rowLevelAccessControls": []
    },
    {
      "name": "media_types",
      "description": "File format a track is sold in (MPEG, AAC, protected variants).",
      "tableReference": "chinook.media_type",
      "columns": [
        {
          "name": "media_type_id",
          "type": "INTEGER",
          "isCalculated": false,
