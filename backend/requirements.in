# Direct runtime dependencies of the backend.
#
# This file is hand-edited; backend/requirements.txt is generated from it and is what
# the image installs and what a local venv should install. Regenerate after any
# change here:
#
#   docker run --rm -v "$PWD/backend:/w" -w /w \
#     python:3.12-slim sh -c \
#     "pip install -q pip-tools && pip-compile --quiet --strip-extras \
#        --output-file=requirements.txt requirements.in"
#
# Why pin at all: two builds a month apart previously installed different versions of
# eight unpinned packages, so a regression could arrive without a single line of this
# repository changing -- and could not be reproduced afterwards, because the versions
# that produced it were never recorded anywhere.

# -- server ------------------------------------------------------------------
fastapi>=0.115
uvicorn[standard]>=0.34
python-multipart>=0.0.20

# -- control plane -----------------------------------------------------------
psycopg2-binary>=2.9.9,<3

# -- credentials at rest, CSRF and OIDC state signing ------------------------
cryptography>=44

# -- outbound mail (password reset, invitations) -----------------------------
aiosmtplib>=3.0

# -- single sign-on: JWKS fetch and id_token verification --------------------
authlib>=1.3,<2

# -- metrics -----------------------------------------------------------------
prometheus-client>=0.20,<1

# -- LLM providers -----------------------------------------------------------
anthropic>=0.40
# 1.x: the integration targets that client surface. See requirements.txt.
openai>=1.60,<2

# -- database drivers --------------------------------------------------------
#
# The connection form offers every engine in vanna.core.datasource, so the image has
# to be able to build a runner for the ones an operator can pick -- offering MySQL
# and then failing on "PyMySQL is required" is a worse experience than not offering
# it. These are pure-Python or ship wheels, so they cost image size and nothing else.
#
# Not here: pyodbc (SQL Server) needs unixODBC plus Microsoft's driver from a
# third-party apt repository, and BigQuery/Snowflake pull large SDKs. All three
# remain available by adding the driver to a derived image's requirements; the
# registry reports them and the runner raises a clear install hint.
pymysql>=1.1
oracledb>=2.5
duckdb>=1.1
clickhouse-connect>=0.8

# -- vector retrieval --------------------------------------------------------
#
# Embeddings come from the OpenAI API (see the `openai` pin above), so there is no
# model, no ONNX runtime and no weight download in this image -- and
# VANNA_INDEX_BACKEND=qdrant needs OPENAI_API_KEY rather than ~130 MB resident per
# worker. Without a key retrieval degrades to keyword-only BM25, which needs neither.
qdrant-client>=1.12

# -- the library's own dependencies ------------------------------------------
#
# `backend/vanna/` is imported from source, not installed, so nothing declares these
# on its behalf and there is no metadata for pip to resolve. They are listed here
# because this file is now the only place that says what the backend needs -- which
# is the trade for dropping the package: one list instead of a pyproject that had to
# agree with it.
pydantic>=2.9
# 2.x: pandas 3 changes copy-on-write and indexing. See requirements.txt.
pandas>=2.2,<3
