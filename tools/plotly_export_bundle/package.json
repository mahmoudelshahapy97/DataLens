{
  "name": "vanna-plotly-export-bundle",
  "private": true,
  "version": "1.0.0",
  "description": "Builds the Plotly bundle embedded in exported dashboards.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2018 --define:global=window --define:process.env.NODE_ENV=\"production\" --outfile=../../backend/vanna/dashboards/vendor/plotly-export.min.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "plotly.js": "^3.1.0"
  }
}
